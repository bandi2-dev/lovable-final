# ResuMate — copy to .env.local (or .env.dev / .env.test / .env.prod) and fill in values.
# Anything prefixed with VITE_ is exposed to the browser.

VITE_APP_ENV=local
VITE_APP_VERSION=0.1.0
VITE_API_BASE_URL=/api

# Mistral AI — get a key at https://console.mistral.ai/api-keys
VITE_MISTRAL_API_KEY=
VITE_MISTRAL_MODEL=mistral-small-latest

# Set to "false" to disable AI calls (test env / CI uses deterministic mock suggestions).
VITE_ENABLE_AI=true

# Supabase (bring your own project — https://supabase.com)
# Leave blank to run fully offline. When set, analyses are persisted to your Supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
